{
  "expo": {
    "scheme": "acme",
    "experiments": {
      "typedRoutes": true
    },
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-audio",
      [
        "expo-image",
        {
          "disableLibdav1d": false
        }
      ]
    ],
    "name": "consumer",
    "slug": "consumer"
  }
}
